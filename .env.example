# Copia este archivo como .env.local y completa los valores.

# Conexión de la app (rol casino_app: sin privilegios sobre tablas).
DATABASE_URL=postgres://casino_app:CAMBIAR_CLAVE_APP@localhost:5432/casino

# Superusuario de PostgreSQL: SOLO lo usa db/run_all.sh para recrear la base.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Clave con la que run_all.sh crea el rol casino_app (debe coincidir con DATABASE_URL).
CASINO_APP_PASSWORD=CAMBIAR_CLAVE_APP

# 32+ bytes aleatorios. Se usa para las respuestas señuelo del login.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_SERVIDOR=

# 1 = acciones con datos de ejemplo en memoria, sin base de datos (para el frontend).
MODO_MOCK=0
# Rol de la sesión simulada cuando MODO_MOCK=1: administrador | crupier | supervisor | jugador
MOCK_ROL=administrador
